<?xml version="1.0"?>
<sdf version="1.9">
  <model name="worker_vest">
    <link name="link">
      <gravity>false</gravity>
      <inertial><pose>0 0 0.95 0 0 0</pose><mass>80</mass>
        <inertia><ixx>27.8</ixx><iyy>24.9</iyy><izz>4.6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><pose>0 0 -0.02 0 0 1.5708</pose>
        <geometry><mesh><uri>model://worker_vest/meshes/walking_worker_vest.dae</uri></mesh></geometry></visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame><robot_base_frame>worker_vest</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>2</dimensions></plugin>
  </model>
</sdf>
