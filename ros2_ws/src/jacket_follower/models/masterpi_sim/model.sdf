<?xml version="1.0"?>
<!-- Simplified Hiwonder MasterPi: 4-wheel mecanum chassis (dimensions from HiwonderSDK mecanum.py:
     a=67 mm, b=59 mm, wheel diameter 65 mm), camera ~0.25 m above ground looking forward/slightly up,
     front ultrasonic range sensor. -->
<sdf version="1.9" xmlns:gz="http://gazebosim.org/schema">
  <model name="masterpi">
    <pose>0 0 0.04 0 0 0</pose>

    <link name="base_link">
      <inertial><mass>1.6</mass>
        <inertia><ixx>0.006</ixx><iyy>0.009</iyy><izz>0.012</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>0.20 0.13 0.06</size></box></geometry></collision>
      <visual name="chassis"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>0.20 0.13 0.06</size></box></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse><ambient>0.3 0.3 0.32 1</ambient></material></visual>
      <visual name="top_plate"><pose>-0.02 0 0.07 0 0 0</pose><geometry><box><size>0.14 0.12 0.004</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material></visual>
      <!-- arm column + camera mast (stands in for the 5-DOF arm holding the camera) -->
      <visual name="arm_base"><pose>0.05 0 0.09 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material></visual>
      <visual name="arm_link"><pose>0.06 0 0.16 0 0 0</pose><geometry><box><size>0.03 0.05 0.12</size></box></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material></visual>
      <visual name="gripper_l"><pose>0.11 0.015 0.14 0 0 0</pose><geometry><box><size>0.05 0.008 0.015</size></box></geometry>
        <material><diffuse>1 0.35 0.1 1</diffuse></material></visual>
      <visual name="gripper_r"><pose>0.11 -0.015 0.14 0 0 0</pose><geometry><box><size>0.05 0.008 0.015</size></box></geometry>
        <material><diffuse>1 0.35 0.1 1</diffuse></material></visual>
      <visual name="sonar_housing"><pose>0.10 0 0.035 0 1.5708 0</pose><geometry><box><size>0.02 0.05 0.01</size></box></geometry>
        <material><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>

      <!-- USB camera on the arm, ~0.25 m above the floor, pitched ~8 deg up -->
      <sensor name="camera" type="camera">
        <pose>0.09 0 0.21 0 -0.14 0</pose>
        <always_on>1</always_on><update_rate>15</update_rate><visualize>false</visualize>
        <topic>camera/image_raw</topic>
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.55</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>40</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>

      <!-- front ultrasonic sensor (MasterPi has one): modelled as a narrow single-ray lidar -->
      <sensor name="sonar" type="gpu_lidar">
        <pose>0.11 0 0.035 0 0 0</pose>
        <update_rate>10</update_rate><topic>range_front_scan</topic>
        <lidar><scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.13</min_angle><max_angle>0.13</max_angle></horizontal></scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>

    <!-- wheels: FL, FR, RL, RR. Mecanum rollers modelled as friction only along a 45 deg diagonal (fdir1, mu2=0),
         the same way as Gazebo's mecanum_drive example -->
    <link name="wheel_fl"><pose>0.067 0.083 0 -1.5708 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.0325</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.0325</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>1 0.55 0.1 1</diffuse></material></visual></link>
    <link name="wheel_fr"><pose>0.067 -0.083 0 -1.5708 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.0325</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.0325</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>1 0.55 0.1 1</diffuse></material></visual></link>
    <link name="wheel_rl"><pose>-0.067 0.083 0 -1.5708 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.0325</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.0325</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>1 0.55 0.1 1</diffuse></material></visual></link>
    <link name="wheel_rr"><pose>-0.067 -0.083 0 -1.5708 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.0325</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.0325</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>1 0.55 0.1 1</diffuse></material></visual></link>

    <joint name="j_fl" type="revolute"><parent>base_link</parent><child>wheel_fl</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="j_fr" type="revolute"><parent>base_link</parent><child>wheel_fr</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="j_rl" type="revolute"><parent>base_link</parent><child>wheel_rl</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="j_rr" type="revolute"><parent>base_link</parent><child>wheel_rr</child><axis><xyz>0 0 1</xyz></axis></joint>

    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>j_fl</front_left_joint><front_right_joint>j_fr</front_right_joint>
      <back_left_joint>j_rl</back_left_joint><back_right_joint>j_rr</back_right_joint>
      <wheel_separation>0.166</wheel_separation><wheelbase>0.134</wheelbase><wheel_radius>0.0325</wheel_radius>
      <min_acceleration>-2</min_acceleration><max_acceleration>2</max_acceleration>
      <topic>cmd_vel</topic><odom_topic>odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame><robot_base_frame>masterpi</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>2</dimensions></plugin>
  </model>
</sdf>
